# Variable names only. No dotenv file is automatically loaded.

# Runtime environment, such as dev or prod.
APP_ENV=

# Public HTTPS origin used for webhook URLs and links.
PUBLIC_BASE_URL=

# PostgreSQL URL supplied by the database service; treated as secret.
DATABASE_URL=

# Server-only OpenAI API credential.
OPENAI_API_KEY=

# Transcription model; default gpt-transcribe.
STT_MODEL=

# Low-latency reasoning model; default gpt-6-luna.
LLM_FAST_MODEL=

# Reply extraction model; default gpt-6.1-sol.
LLM_ACCURATE_MODEL=

# Speech synthesis model; default gpt-4o-mini-tts.
TTS_MODEL=

# Fast reasoning effort; default none.
LLM_FAST_EFFORT=

# Accurate reasoning effort; default low.
LLM_ACCURATE_EFFORT=

# Speech voice; default marin.
TTS_VOICE=

# Realtime call model; default gpt-realtime-2.1.
REALTIME_MODEL=

# Live transcription model inside the call; default gpt-live-transcribe.
REALTIME_TRANSCRIBE_MODEL=

# Realtime voice; default marin.
REALTIME_VOICE=

# Agents SDK tracing; default true. Sensitive data stays out of traces.
AGENTS_TRACING=

# Real outbound phone calls; default false.
PHONE_CALLS_ENABLED=

# Twilio account SID, only when phone calls are enabled.
TWILIO_ACCOUNT_SID=

# Twilio auth token, only when phone calls are enabled.
TWILIO_AUTH_TOKEN=

# Twilio caller number in E.164, only when phone calls are enabled.
TWILIO_CALLER_NUMBER=

# Telegram bot credential from BotFather.
TELEGRAM_BOT_TOKEN=

# Secret header value used to verify Telegram updates.
TELEGRAM_WEBHOOK_SECRET=

# Telegram transport; default webhook, polling is the fallback.
TELEGRAM_MODE=

# Meta messaging access token.
WHATSAPP_TOKEN=

# Meta app secret used to verify raw webhook signatures.
WHATSAPP_APP_SECRET=

# Secret used for the WhatsApp subscription challenge.
WHATSAPP_VERIFY_TOKEN=

# Meta test phone number identifier.
WHATSAPP_PHONE_NUMBER_ID=

# OAuth client identifier. The demo client is a Web client in mehu-511820.
# http://localhost:8765/ is its consent redirect, used only while minting a token.
GOOGLE_CLIENT_ID=

# OAuth client secret. Never commit a real value.
GOOGLE_CLIENT_SECRET=

# Family mailbox refresh token from the one-time local consent.
# The deployed app uses this token. It does not repeat the localhost redirect.
GOOGLE_REFRESH_TOKEN_FAMILY=

# Providers mailbox refresh token. The demo uses the same token as the family mailbox.
GOOGLE_REFRESH_TOKEN_PROVIDERS=

# Team-controlled family demo email address.
# Live demo uses the one Gmail account connected through Fastn for both roles.
FAMILY_MAILBOX=

# Team-controlled providers demo email address.
# Same Fastn-connected account as FAMILY_MAILBOX until a second inbox exists.
PROVIDERS_MAILBOX=

# Fernet encryption key; keep fixed throughout the event.
VAULT_KEY=

# Judge access passcode; set directly in platform variables.
DEMO_PASSCODE=

# Inbox polling interval in seconds; default 15.
POLL_SECONDS=

# Explicit opt-in for text logs; default false, keep disabled for demos.
LOG_TRANSCRIPTS=

# Tooling-only isolated PostgreSQL test database URL, beyond T14.
DATABASE_URL_TEST=
